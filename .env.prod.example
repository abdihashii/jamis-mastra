# Template for .env.prod on the VPS. Copy it there, fill it in, chmod 600.
# Hostnames are compose service names, not localhost: the app runs in the stack.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

NEURALWATT_API_KEY=
# Search defaults to perplexity; set firecrawl to select Firecrawl search.
WEB_SEARCH_PROVIDER=perplexity
# Required only for perplexity search.
PERPLEXITY_API_KEY=
# Always required for page reading, also used for firecrawl search.
FIRECRAWL_API_KEY=
OPEN_WEATHER_API_KEY=

# Bearer token for the Mastra API and Studio (B4). Generate with:
#   openssl rand -hex 32
API_TOKEN=

# Google Desktop OAuth client, same values as dev .env. Tokens live in
# data/google-oauth.json on the volume, never here. See docs/setup-gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jamis Linear app, read-only Stage 1. See docs/setup-linear.md. No access token.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
JAMIS_ALLOWED_NUMBER=

# Required IANA zone for operator-facing dates and times. Runtime clocks stay UTC.
OPERATOR_TIMEZONE=America/Chicago

# Fantasy weekly recap (JAM-54). All four required; partial config disables it.
FANTASY_SENDBLUE_GROUP_ID=
FANTASY_SLEEPER_LEAGUE_ID=
FANTASY_MANAGER_MAP={"+15551234567":"1234567890","+15557654321":"0987654321"} # JSON of {"+<E.164 phone>":"<sleeper user id>"}, private
FANTASY_RECAP_TIMEZONE=America/Chicago

# Cloudflare tunnel token, from the Zero Trust dashboard (B6).
TUNNEL_TOKEN=

# Must match the password in DATABASE_URL below.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/mastra

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
