NEURALWATT_API_KEY=
# Search defaults to perplexity; set firecrawl to select Firecrawl search.
WEB_SEARCH_PROVIDER=perplexity
# Required only for perplexity search.
PERPLEXITY_API_KEY=
# Always required for page reading, also used for firecrawl search.
FIRECRAWL_API_KEY=
OPEN_WEATHER_API_KEY=

# Required, including for mastra dev: the API and Studio both refuse requests
# without it. Any string works locally; use openssl rand -hex 32 for real ones.
API_TOKEN=

# Google Desktop OAuth client (consent screen production-published, gmail.readonly).
# Tokens live in data/google-oauth.json, never here. See docs/setup-gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jamis Linear app, read-only. See docs/setup-linear.md. No access token.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
JAMIS_ALLOWED_NUMBER=

# Required IANA zone for operator-facing dates and times. Runtime clocks stay UTC.
OPERATOR_TIMEZONE=America/Chicago

# Fantasy weekly recap (JAM-54). All four required; partial config disables it.
FANTASY_SENDBLUE_GROUP_ID=
FANTASY_SLEEPER_LEAGUE_ID=
FANTASY_MANAGER_MAP={"+15551234567":"1234567890","+15557654321":"0987654321"} # JSON of {"+<E.164 phone>":"<sleeper user id>"}, private
FANTASY_RECAP_TIMEZONE=America/Chicago

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mastra

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=password
