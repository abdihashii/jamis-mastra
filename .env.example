FIREWORKS_API_KEY=
FIRECRAWL_API_KEY=
OPEN_WEATHER_API_KEY=

# Required, including for mastra dev: the API and Studio both refuse requests
# without it. Any string works locally; use openssl rand -hex 32 for real ones.
API_TOKEN=

# Google Desktop OAuth client (consent screen production-published, gmail.readonly).
# Tokens live in data/google-oauth.json, never here. See docs/setup-gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
JAMIS_ALLOWED_NUMBER=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mastra
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=password
