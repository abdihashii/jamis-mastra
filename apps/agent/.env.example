FIREWORKS_API_KEY=

# Required, including for mastra dev: the API and Studio both refuse requests
# without it. Any string works locally; use openssl rand -hex 32 for real ones.
API_TOKEN=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mastra
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=password
